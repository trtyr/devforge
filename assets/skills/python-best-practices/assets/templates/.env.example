# 开发默认即可不设;以下为可覆盖项示例(前缀 APP_)
# APP_IS_DEBUG=1
# APP_BEARTYPE_ON=false        # 仅生产关闭运行时类型检查
# APP_LLM_PROVIDER=openai      # 默认 mock(离线可跑);切换真实实现
# APP_RETRIEVER__TOP_K=20      # 覆盖嵌套配置字段
# APP_ROOT_DIR=/srv/app        # 仓库根;仅在项目树外运行(wheel/容器)时需要。
#                              # 它不是 Settings 字段,由 settings.py 直接 os.getenv 读
#                              # (ROOT_DIR 在 Settings 实例化之前就要用到)。
